          "interface-name": "fxp0.0"
        },
        {
          "hostname": "172.20.160.2",
          "ip-address": "172.20.160.2",
          "mac-address": "00:1b:0d:ef:79:40",
          "interface-name": "fxp0.0"
        },
        {
          "hostname": "172.20.160.3",
          "ip-address": "172.20.160.3",
          "mac-address": "00:1b:0d:ef:7f:00",
          "interface-name": "fxp0.0"
        }
      ]
    },
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT15M"
      }
    },
    "functions": [
      {
        "name": "noop",
        "metadata": {
          "worker": "default"
        },
        "operation": "system.function.@latest.common.NoOp"
      }
    ],
    "description": "Checks the status of the device (Juniper devices) to see if the Address Resolution Protocol (ARP) details for pre and post upgrade are same. If there are differences then \"warning\" is returned. If the execution fails then the status would be returned as \"failed\", else it would be \"success\".",
    "specVersion": "0.8",
    "dataInputSchema": {
      "schema": {
        "type": "object",
        "title": "arpCheckSchema",
        "properties": {
          "app-data": {
            "type": "object",
            "required": [
              "device",
              "resource"
            ],
            "properties": {
              "device": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "resource": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "wfTags": [
    "mopActivity",
    "noExport"
  ],
