{
  "workflowId": "2bc38414-ddaf-44d0-9626-1d0443b60242",
  "createdAt": "2026-02-18T01:41:38.195175Z",
  "updatedAt": "2026-02-18T01:41:38.195175Z",
  "name": "apply-golden-config-cwm-sol",
  "version": "2.1.0",
  "description": "Golden Config apply configuration workflow: This workflow is for configuration stage, it calls golden config API to apply configuration on a device. Workflow output has status field which will contain success or failed and message.",
  "definition": {
    "id": "apply-golden-config-cwm-sol",
    "name": "apply-golden-config-cwm-sol",
    "start": "Begin",
    "errors": [
      {
        "code": "DEFAULT",
        "name": "Default_Exception",
        "description": "DEFAULT ERROR"
      },
      {
        "code": "HTTP_STATUS_500",
        "name": "Http_Error_500",
        "description": "HTTP 500 ERROR"
      },
      {
        "code": "HTTP_STATUS_400",
        "name": "Bad_Request",
        "description": "BAD REQUEST"
      },
      {
        "code": "ActivityTimeoutError",
        "name": "Timeout_Error_Activity",
        "description": "Timeout error"
      }
    ],
    "states": [
      {
        "name": "Begin",
        "type": "operation",
        "actions": [
          {
            "name": "gc-apply-config-API",
            "functionRef": {
              "refName": "REST.Post",
              "arguments": {
                "input": {
                  "data": {
                    "jobId": "${$CONST.CWM.JOB_ID}",
                    "runId": "${$CONST.CWM.RUN_ID}",
                    "stage": "configuration",
                    "jobData": "${.}"
                  },
                  "path": "v1/applications",
                  "header": {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                  }
                },
                "config": {
                  "resource": {
                    "connection": {
                      "host": "cwm-solutions-gc",
                      "port": 8080,
                      "protocol": "http"
                    }
                  }
                }
              }
            },
            "actionDataFilter": {
              "results": "${.}"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "LOG",
              "message": "GC API called"
            }
          ]
        },
        "onErrors": [
          {
            "errorRef": "Http_Error_500",
            "transition": "api-error"
          },
          {
            "errorRef": "Bad_Request",
            "transition": "bad-request"
          },
          {
            "errorRef": "Timeout_Error_Activity",
            "transition": "timeout-error"
          },
          {
            "errorRef": "Default_Exception",
            "transition": "abnormal-exit"
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT30M"
        },
        "transition": "api-success",
        "stateDataFilter": {
          "output": "${ .data | del(.code) + {errors: $ERRORS} }"
        }
      },
      {
        "name": "api-success",
        "type": "operation",
        "actions": [],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "API returned success"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": "end",
        "stateDataFilter": {
          "output": "${.|del(.errors)}"
        }
      },
      {
        "name": "api-error",
        "type": "operation",
        "actions": [],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "API returned HTTP error code 5xx"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": "end",
        "stateDataFilter": {
          "output": "${ {status:\"failed\", message:.errors[0].error} }"
        }
      },
      {
        "name": "bad-request",
        "type": "operation",
        "actions": [],
        "metadata": {
          "logs": [
            {
              "level": "ERROR",
              "message": "API returned HTTP error code 4xx"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": "end",
        "stateDataFilter": {
          "output": "${ {status:\"failed\", message:.errors[0].error}}"
        }
      },
      {
        "name": "timeout-error",
        "type": "operation",
        "actions": [],
        "metadata": {
          "logs": [
            {
              "level": "ERROR",
              "message": "Timeout error"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": "end",
        "stateDataFilter": {
          "output": "${.}"
        }
      },
      {
        "name": "abnormal-exit",
        "type": "operation",
        "actions": [],
        "metadata": {
          "logs": [
            {
              "level": "ERROR",
              "message": "Exited abnormally"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": "end",
        "stateDataFilter": {
          "output": "${.}"
        }
      },
      {
        "end": true,
        "name": "end",
        "type": "operation",
        "actions": [],
        "timeouts": {
          "stateExecTimeout": "PT15M"
        }
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT60S",
        "maxAttempts": 1
      }
    ],
    "version": "2.1.0",
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT35M"
      }
    },
    "functions": [
      {
        "name": "REST.Post",
        "metadata": {
          "worker": "cwm-solutions-generic.rest"
        },
        "operation": "generic.rest.@latest.request.Post"
      }
    ],
    "description": "Golden Config apply configuration workflow: This workflow is for configuration stage, it calls golden config API to apply configuration on a device. Workflow output has status field which will contain success or failed and message.",
    "specVersion": "0.8",
    "dataInputSchema": {
      "schema": {
        "type": "object",
        "title": "Golden Config Apply Configuration Schema",
        "properties": {
          "app-data": {
            "type": "object",
            "title": "Application Data",
            "required": [
              "device",
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "title": "Configuration Data",
                "required": [
                  "templates"
                ],
                "properties": {
                  "templates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "tcId"
                      ],
                      "properties": {
                        "tcId": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "variables": {
                          "type": "array",
                          "items": {
                            "if": {
                              "properties": {
                                "type": {
                                  "const": "JSON"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                  ]
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": [
                                    "object",
                                    "array"
                                  ]
                                }
                              }
                            },
                            "type": "object",
                            "required": [
                              "name",
                              "value",
                              "type"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "type": {
                                "enum": [
                                  "STRING",
                                  "JSON"
                                ],
                                "type": "string"
                              },
                              "source": {
                                "enum": [
                                  "TEMPLATE",
                                  "GLOBAL",
                                  null
                                ],
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "title": "Variable Source",
                                "description": "The origin of the variable (TEMPLATE, GLOBAL, or None)."
                              }
                            }
                          },
                          "title": "Template Variables",
                          "description": "Variables to substitute in the template"
                        },
                        "templateName": {
                          "type": "string",
                          "title": "Template Name",
                          "minLength": 1,
                          "description": "Name of the golden config template to apply"
                        }
                      }
                    },
                    "minItems": 1
                  }
                }
              },
              "device": {
                "type": "object",
                "title": "Device Information",
                "required": [
                  "name",
                  "host",
                  "vendor",
                  "productSeries"
                ],
                "properties": {
                  "ip": {
                    "type": "string",
                    "title": "IP Address",
                    "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$|^(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$",
                    "examples": [
                      "192.168.1.1",
                      "10.0.0.1",
                      "2001:db8::1"
                    ],
                    "description": "Device management IP address"
                  },
                  "host": {
                    "type": "string",
                    "title": "Host Name",
                    "description": "Device hostname or FQDN"
                  },
                  "name": {
                    "type": "string",
                    "title": "Device Name",
                    "description": "Unique device identifier name"
                  },
                  "uuid": {
                    "type": "string",
                    "title": "UUID",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "description": "Unique device identifier"
                  },
                  "label": {
                    "type": "string",
                    "title": "Device Label",
                    "description": "Human-readable device label"
                  },
                  "vendor": {
                    "type": "string",
                    "title": "Vendor",
                    "description": "Device vendor name"
                  },
                  "resource": {
                    "type": "string",
                    "title": "Resource ID",
                    "description": "Network management resource identifier"
                  },
                  "productType": {
                    "type": "string",
                    "title": "Product Type",
                    "description": "Specific product type model"
                  },
                  "softwareType": {
                    "type": "string",
                    "title": "Software Type",
                    "description": "Operating system type"
                  },
                  "productSeries": {
                    "type": "string",
                    "title": "Product Series",
                    "description": "Device product series identifier"
                  },
                  "softwareVersion": {
                    "type": "string",
                    "title": "Software Version",
                    "description": "Current software version"
                  }
                },
                "description": "Target device configuration details"
              }
            },
            "description": "Main application data containing device and template information"
          }
        },
        "description": "Configuration schema for applying golden config templates to network devices"
      },
      "failOnValidationErrors": true
    }
  },
  "wfTags": [
    "mopActivity",
    "noExport"
  ],
  "formId": "",
  "path": "",
  "hashSum": "4bfeddff689508f809d73033f541790539944d5714addb6ecc1f324f104d494a"
}