{
  "workflowId": "87c6cef7-2c18-4d17-8a02-56c75eee0d88",
  "createdAt": "2026-02-18T01:36:29.41289Z",
  "updatedAt": "2026-06-29T21:45:15.975045Z",
  "name": "sw-version-cwm-sol",
  "version": "2.1.0",
  "description": "Checks the device version with the image version provided in the input. If there is a mismatch, then the the version obtained from the device is searched in the image file name provided. If there is a match then the stauts is \"success\", otherwise \"warning\" is returned and \"failure\" is returned in case of an execution error.",
  "definition": {
    "id": "sw-version-cwm-sol",
    "name": "sw-version-cwm-sol",
    "start": "check-device",
    "errors": [
      {
        "code": "DEFAULT",
        "name": "Default_Exception",
        "description": "DEFAULT ERROR"
      }
    ],
    "states": [
      {
        "name": "check-device",
        "type": "switch",
        "dataConditions": [
          {
            "name": "check-iosxr",
            "condition": "${ (.\"app-data\".device.productSeries == \"Cisco 8000 Series Routers\") or (.\"app-data\".device.productSeries == \"Cisco Network Convergence System 540L Series Routers\") or (.\"app-data\".device.productSeries == \"Cisco Network Convergence System 5700 Series Routers\") or (.\"app-data\".device.productSeries == \"Cisco ASR 9000 Series Aggregation Services Routers\") or (.\"app-data\".device.productSeries == \"Cisco XRv 9000 Series Virtual Routers\") or (.\"app-data\".device.productSeries == \"Cisco Network Convergence System 5500 Series\") or (.\"app-data\".device.productSeries == \"Cisco Network Convergence System 540 Series Routers\") }",
            "transition": "inject-template-and-expressions-xr"
          },
          {
            "name": "check-iosxe",
            "condition": "${ (.\"app-data\".device.productSeries == \"Cisco ASR 920 Series Aggregation Services Routers\") or (.\"app-data\".device.productSeries == \"Cisco ASR 900 Series Aggregation Services Routers\") or (.\"app-data\".device.productSeries == \"Cisco ASR 1000 Series Aggregation Services Routers\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 8000V Edge Chassis Platforms\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 9300 Series Switches\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 3650 Series Switches\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 8300 Series Edge Platforms\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 9500 Series Switches\") or (.\"app-data\".device.productSeries == \"Cisco Catalyst 9500 series switches\") }",
            "transition": "get-sw-version-xe"
          }
        ],
        "defaultCondition": {
          "transition": "invalid-productSeries-error"
        }
      },
      {
        "data": {
          "template": "Value Version (\\d+\\.\\d+\\.\\d+)\n\nStart\n  ^*Version ${Version} -> Record",
          "expressions": [
            {
              "status": "success",
              "message": "Version check failed",
              "condition": "((. | length > 0) and (.[] | (.Version != null and .Version != \"\")))"
            }
          ]
        },
        "name": "inject-template-and-expressions-xr",
        "type": "inject",
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Forming inputs for version check"
            }
          ]
        },
        "transition": "execute-version-check-command"
      },
      {
        "name": "execute-version-check-command",
        "type": "operation",
        "actions": [
          {
            "subFlowRef": {
              "invoke": "sync",
              "version": "2.1.0",
              "workflowId": "util-executor-cwm-sol",
              "onParentComplete": "continue"
            },
            "actionDataFilter": {
              "toStateData": "${.rakutilExecutorData}",
              "fromStateData": "${({\"device\": .\"app-data\".device.name, \"NSOResourceId\": .\"app-data\".\"resource\", \"rak-resource\": \"cwm.sol.system.util\", \"command\": \"show version\", \"template\": .template, \"expressions\": .expressions, \"vendor\": \"Cisco Systems\" })}"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Calling util executor"
            }
          ]
        },
        "onErrors": [
          {
            "errorRef": "Default_Exception",
            "transition": "abnormal-exit"
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT15M"
        },
        "transition": "validate-rakutil-executor-check"
      },
      {
        "name": "validate-rakutil-executor-check",
        "type": "switch",
        "dataConditions": [
          {
            "name": "output is valid",
            "condition": "${ if .rakutilExecutorData.status==\"success\" then true else false end}",
            "transition": "validate-version"
          },
          {
            "name": "output is invalid",
            "condition": "${ if .rakutilExecutorData.status==\"failed\" then true else false end}",
            "transition": "return-failure"
          }
        ],
        "defaultCondition": {
          "transition": "abnormal-exit"
        }
      },
      {
        "name": "get-sw-version-xe",
        "type": "operation",
        "actions": [
          {
            "subFlowRef": {
              "invoke": "sync",
              "version": "2.1.0",
              "workflowId": "nsoactivityexecutor-cwm-sol",
              "onParentComplete": "continue"
            },
            "actionDataFilter": {
              "fromStateData": "${ .activity.resourceId = .\"app-data\".\"resource\" | .activity.device = .\"app-data\".device.name | .activity.method = \"getVersionXE\" }"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Calling nsoactivityexecutor to get the version of the XE device"
            }
          ]
        },
        "onErrors": [
          {
            "errorRef": "Default_Exception",
            "transition": "abnormal-exit"
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT15M"
        },
        "transition": "validate-NSO-version-check"
      },
      {
        "name": "validate-NSO-version-check",
        "type": "switch",
        "dataConditions": [
          {
            "name": "output is valid",
            "condition": "${ if .activityOutput.status==\"success\" then true else false end}",
            "transition": "validate-version"
          }
        ],
        "defaultCondition": {
          "transition": "return-failure"
        }
      },
      {
        "name": "validate-version",
        "type": "switch",
        "dataConditions": [
          {
            "name": "output is valid",
            "condition": "${ (.rakutilExecutorData.stash.output[0].Version == .\"app-data\".data.imageVersion ) or (.activityOutput.output.\"tailf-ned-cisco-ios-stats:version\" == .\"app-data\".data.imageVersion ) }",
            "transition": "return-success"
          }
        ],
        "defaultCondition": {
          "transition": "validate-version-failover"
        }
      },
      {
        "name": "validate-version-failover",
        "type": "switch",
        "dataConditions": [
          {
            "name": "output is valid XR",
            "condition": "${ (.rakutilExecutorData.stash.output[0].Version as $version | if (.\"app-data\".data.softwareImages[0] | contains($version)) then true else false end) }",
            "transition": "return-success"
          },
          {
            "name": "output is valid XE",
            "condition": "${ (.activityOutput.output.\"tailf-ned-cisco-ios-stats:version\" as $version | if (.\"app-data\".data.softwareImages[0] | contains($version)) then true else false end) }",
            "transition": "return-success"
          }
        ],
        "defaultCondition": {
          "transition": "return-version-failure"
        }
      },
      {
        "name": "return-success",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Version check completed successfully"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${ {status:\"success\", message: \"Version check completed successfully\"} }"
        }
      },
      {
        "name": "return-version-failure",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "Version check failed"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: \"Version check failed.\", stash: (if .activityOutput.output.\"tailf-ned-cisco-ios-stats:version\" != null then [.activityOutput.output.\"tailf-ned-cisco-ios-stats:version\"] else .rakutilExecutorData.stash.output end) }}"
        }
      },
      {
        "name": "invalid-productSeries-error",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "Version check failed"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: \"Wrong product series selected.\" }}"
        }
      },
      {
        "name": "return-failure",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "Version check failed"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: (\"Version check failed. \" + (if .rakutilExecutorData.message then .rakutilExecutorData.message else (if .errors[0].error != null then \"Error is: \" + .errors[0].error else \"Exited Abnormally.\" end) end)) }}"
        }
      },
      {
        "name": "abnormal-exit",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Version check exited abnormally"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: (\"Version check failed. \" + (if .rakutilExecutorData.message then .rakutilExecutorData.message else (if .errors[0].error != null then \"Error is: \" + .errors[0].error else \"Exited Abnormally.\" end) end)) }}"
        }
      },
      {
        "end": true,
        "name": "end",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "stateDataFilter": {
          "output": "${ . }"
        }
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT5S",
        "multiplier": 1.1,
        "maxAttempts": 2
      }
    ],
    "version": "2.1.0",
    "metadata": {},
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT15M"
      }
    },
    "functions": [
      {
        "name": "noop",
        "metadata": {
          "worker": "default"
        },
        "operation": "system.function.@latest.common.NoOp"
      }
    ],
    "description": "Checks the device version with the image version provided in the input. If there is a mismatch, then the the version obtained from the device is searched in the image file name provided. If there is a match then the stauts is \"success\", otherwise \"warning\" is returned and \"failure\" is returned in case of an execution error.",
    "specVersion": "0.8",
    "dataInputSchema": {
      "schema": {
        "type": "object",
        "title": "swVersionCheckSchema",
        "properties": {
          "app-data": {
            "type": "object",
            "required": [
              "device",
              "resource",
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "softwareImages",
                  "imageVersion"
                ],
                "properties": {
                  "imageVersion": {
                    "type": "string"
                  },
                  "softwareImages": {
                    "type": "array"
                  }
                }
              },
              "device": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "resource": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "wfTags": [
    "mopActivity",
    "noExport"
  ],
  "formId": "",
  "path": "",
  "hashSum": "1f31042e11e667a59011c14fc4abff2bbca68bd96848f6acb14b90d7299bd769"
}