{
  "workflowId": "2b97dcbf-8236-4b96-a634-c00d1edb80a4",
  "createdAt": "2026-02-18T01:46:16.499454Z",
  "updatedAt": "2026-02-18T01:46:16.499454Z",
  "name": "inventory-refresh-ems-cwm-sol",
  "version": "1.0.0",
  "description": "Workflow to invoke refresh ems action to get ems result for the xr and xe devices in NSO resource.",
  "definition": {
    "id": "inventory-refresh-ems-cwm-sol",
    "name": "inventory-refresh-ems-cwm-sol",
    "start": "Begin",
    "errors": [
      {
        "code": "DEFAULT",
        "name": "ERROR"
      },
      {
        "code": "ResourceNotFound",
        "name": "invalidResource"
      },
      {
        "code": "HTTP_STATUS_400",
        "name": "Bad_Request",
        "description": "BAD REQUEST"
      },
      {
        "code": "NSO_ACCESS_DENIED",
        "name": "Access_Denied",
        "description": "RESOURCE UNAUTHORIZED"
      },
      {
        "code": "HTTP_STATUS_403",
        "name": "Resource_Unauthorized",
        "description": "RESOURCE UNAUTHORIZED"
      }
    ],
    "states": [
      {
        "name": "Begin",
        "type": "operation",
        "actions": [
          {
            "name": "InvokeRefreshEMSAction",
            "retryRef": "Default",
            "functionRef": {
              "refName": "NSO.RestconfPost",
              "arguments": {
                "input": {
                  "data": "{\"device\": \"${ .device | tostring }\"}",
                  "path": "restconf/operations/inventory:inventory/refresh-ems?unhide=debug"
                },
                "config": {
                  "resourceId": "${ .resourceId }"
                }
              }
            }
          }
        ],
        "onErrors": [
          {
            "errorRef": "ERROR",
            "transition": "GenericOtherErrors"
          },
          {
            "errorRef": "invalidResource",
            "transition": "abnormal-exit"
          },
          {
            "errorRef": "Access_Denied",
            "transition": "unauthorized-access"
          },
          {
            "errorRef": "Bad_Request",
            "transition": "bad-request"
          },
          {
            "errorRef": "Resource_Unauthorized",
            "transition": "unauthorized-access"
          }
        ],
        "transition": {
          "nextState": "JobCompleted"
        },
        "stateDataFilter": {
          "input": "${ . }"
        }
      },
      {
        "end": true,
        "name": "GenericOtherErrors",
        "type": "operation",
        "actions": [],
        "stateDataFilter": {
          "output": "${ . |= .+ {\"status\": \"Error occurred in getting inventory result for device from resource\"}}"
        }
      },
      {
        "end": true,
        "name": "abnormal-exit",
        "type": "operation",
        "actions": [],
        "stateDataFilter": {
          "output": "${ . |= .+ {\"status\": \"failed\", \"message\": \"Resouce not found.\"}}"
        }
      },
      {
        "end": true,
        "name": "bad-request",
        "type": "operation",
        "actions": [],
        "stateDataFilter": {
          "output": "${ {output: {\"status\":\"error\", \"message\":\"Please check the input the request to NSO command/operation is not in correct format.\", \"device\": .device}} }"
        }
      },
      {
        "end": true,
        "name": "unauthorized-access",
        "type": "operation",
        "actions": [],
        "stateDataFilter": {
          "output": "${ {output: {\"status\":\"error\", \"message\":\"Enable to execute command or action on NSO due to missing  permissions/access.\", \"device\": .device}} }"
        }
      },
      {
        "end": true,
        "name": "JobCompleted",
        "type": "operation",
        "actions": [],
        "stateDataFilter": {
          "output": "${(if (.data and .data.\"inventory:output\" != \"\") then {\"result\":.data.\"inventory:output\", \"status\": .data.\"inventory:output\".status} else {\"result\": null, \"status\": .data.\"inventory:output\".status} end | del(.resourceId))}"
        }
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT5S",
        "multiplier": 1.1,
        "maxAttempts": 3
      }
    ],
    "version": "1.0.0",
    "functions": [
      {
        "name": "NSO.RestconfPost",
        "metadata": {
          "worker": "cwm-solutions-cisco.nso"
        },
        "operation": "cisco.nso.@latest.restconf.Post"
      }
    ],
    "description": "Workflow to invoke refresh ems action to get ems result for the xr and xe devices in NSO resource.",
    "specVersion": "0.9"
  },
  "wfTags": [
    "app:Inventory"
  ],
  "formId": "",
  "path": "",
  "hashSum": "3b3ad03133ddddd88431c648cead099623e7841f9cdfbbafff6f7e60dd87410f"
}