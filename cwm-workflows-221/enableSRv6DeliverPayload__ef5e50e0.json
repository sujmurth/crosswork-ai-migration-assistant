  "name": "enableSRv6DeliverPayload",
  "version": "1.0",
  "description": "Create and deliver enable IPv6 golden config payload",
  "definition": {
    "id": "enableSRv6DeliverPayload-1.0",
    "name": "enableSRv6DeliverPayload",
    "start": "InjectP1",
    "errors": [
      {
        "code": "HTTP_STATUS_400",
        "name": "NSOError",
        "description": "NSOErr: NSO Data Error"
      },
      {
        "code": "HTTP_STATUS_403",
        "name": "resourceUnauthorized",
        "description": "NSOErr: Resource Unauthorized"
      },
      {
        "code": "HTTP_STATUS_404",
        "name": "entityNotFound",
        "description": "NSOErr: Entity Not Found"
      },
      {
        "code": "HTTP_STATUS_409",
        "name": "resourceExists",
        "description": "NSOErr: Resource already exists"
      },
      {
        "code": "HTTP_STATUS_500",
        "name": "noRouteToHost",
        "description": "NSOErr: No Route to NSO host"
      }
    ],
    "states": [
      {
        "data": {
          "P1": "{\r\n    \"application\": [\r\n      {\r\n        \"device\": \""
        },
        "name": "InjectP1",
        "type": "inject",
        "transition": "InjectP2"
      },
      {
        "data": {
          "P2": "\",\r\n        \"jinja-template\": {\r\n          \"template\": \"srv6-setup-template\",\r\n          \"version\": \"1\"\r\n        },\r\n        \"name\": \"cwm-gc-enable-SRv6-"
        },
        "name": "InjectP2",
        "type": "inject",
        "transition": "InjectP3"
      },
      {
        "data": {
          "P3": "\"\r\n      }\r\n    ]\r\n  }\r\n} "
        },
        "name": "InjectP3",
        "type": "inject",
        "transition": "concatenatePayload"
      },
      {
        "name": "concatenatePayload",
        "type": "operation",
        "transition": "SRv6-GC-Template-Apply",
        "stateDataFilter": {
          "input": "${ . }",
          "output": "${ { payload: ({ application: [ { device: .node.name, \"jinja-template\": { template: (if (.node.name == \"node-3\") then \"srv6-setup-template-node3-xe\" else \"srv6-setup-template\" end), version: \"1\" }, name: (\"cwm-gc-enable-SRv6-\" + .node.name) } ] } | tojson), node: .node.name, action: \"Enable SRv6 on device\" } }"
        }
      },
      {
        "end": {
          "terminate": true
        },
        "name": "SRv6-GC-Template-Apply",
        "type": "operation",
        "actions": [
          {
            "name": "SRv6configsAPPLY",
            "retryRef": "Default",
            "functionRef": {
              "refName": "NSO.RestconfPatch",
              "arguments": {
                "input": {
                  "data": "${ {\"golden-config:golden-config\": (.payload | fromjson)} }",
                  "path": "restconf/data/golden-config:golden-config?dry-run=native",
                  "header": {
                    "Accept": "application/yang-data+json",
                    "Content-Type": "application/yang-data+json"
                  }
                },
                "config": {
                  "resourceId": "eNSO"
                }
              }
            }
          }
        ]
      },
      {
        "end": true,
        "name": "getNodeLiveStatus",
        "type": "operation",
        "actions": [
          {
            "version": "1.0",
            "subFlowRef": {
              "invoke": "sync",
              "version": "1.0",
              "workflowId": "genericNSOGetLiveStatus"
            }
          }
        ]
      },
      {
        "data": {
          "N1": "restconf/data/golden-config:golden-config/golden-config:application=cwm-gc-enable-SRv6-"
        },
        "name": "InjectN1",
        "type": "inject",
        "transition": "InjectN2"
      },
      {
        "data": {
          "N2": "/golden-config:get-modifications"
        },
        "name": "InjectN2",
        "type": "inject",
        "transition": "concatenateNSOPath"
      },
      {
        "name": "concatenateNSOPath",
        "type": "operation",
        "transition": "SRv6-GC-Template-Validate",
        "stateDataFilter": {
          "input": "${ . }",
          "output": "${ { nsoPath: \"\\(.N1 + .node + .N2)\" } }"
        }
      },
      {
        "end": true,
        "name": "SRv6-GC-Template-Validate",
        "type": "operation",
        "actions": [
          {
            "name": "SRv6configsVALIDATE",
            "retryRef": "Default",
            "functionRef": {
              "refName": "NSO.RestconfPost",
              "arguments": {
                "input": {
                  "data": {},
                  "path": "${ .nsoPath }",
                  "header": {
                    "Accept": "application/yang-data+json",
                    "Content-Type": "application/yang-data+json"
                  }
                },
                "config": {
                  "resourceId": "eNSO"
                }
              }
            }
          }
        ]
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT20S",
        "multiplier": 1.5,
        "maxAttempts": 2
      }
    ],
    "version": "1.0",
    "functions": [
