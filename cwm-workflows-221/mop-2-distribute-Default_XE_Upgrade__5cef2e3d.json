    "start": "validate image-distribute",
    "events": [
      {
        "name": "cwm.sol.system.mopAction",
        "type": "cwm.sol.system.mopAction",
        "source": "actionStatusSource",
        "correlation": [
          {
            "contextAttributeName": "jobId",
            "contextAttributeValue": "${.jobId}"
          },
          {
            "contextAttributeName": "runId",
            "contextAttributeValue": "${.runId}"
          }
        ]
      }
    ],
    "states": [
      {
        "name": "validate image-distribute",
        "type": "operation",
        "actions": [
          {
            "name": "evaluate-expressions-cwm-sol-2.1.0",
            "functionRef": {
              "refName": "REST.Post",
              "arguments": {
                "input": {
                  "data": {
                    "jobId": "${$CONST.CWM.JOB_ID}",
                    "mopId": 2,
                    "runId": "${$CONST.CWM.RUN_ID}",
                    "stage": "distribute",
                    "app-data": "${. + {\"actionTimeout\": \"PT15M\"}}"
                  },
                  "path": "v1/mop/action/validate image",
                  "header": {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                  }
                },
                "config": {
                  "resource": {
                    "connection": {
                      "host": "cwm-solutions-automation",
                      "port": 8080,
                      "protocol": "http"
                    }
                  }
                }
              }
            },
            "actionDataFilter": {
              "results": "${.data}"
            }
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT5M"
        },
        "transition": "check-status-validate image-distribute",
        "stateDataFilter": {
          "output": "${.}"
        }
      },
      {
        "name": "check-status-validate image-distribute",
        "type": "switch",
        "dataConditions": [
          {
            "condition": "${.status == \"success\" or .status == \"warning\"}",
            "transition": "process-output-validate image-distribute"
          },
          {
            "condition": "${.status == \"running\"}",
            "transition": "check-event-validate image-distribute"
          },
          {
            "condition": "${.status == \"terminated\"}",
            "transition": "abortExecution"
          }
        ],
        "defaultCondition": {
          "transition": "failedExecution"
        }
      },
      {
        "name": "check-event-validate image-distribute",
        "type": "switch",
        "timeouts": {
          "eventTimeout": "PT15M"
        },
        "eventConditions": [
          {
            "eventRef": "cwm.sol.system.mopAction",
            "transition": "check-status-validate image-distribute",
            "eventDataFilter": {
              "data": "${ {jobId : .jobId, runId : .runId, status : .status, message : .message, \"app-data\": .\"app-data\"} }",
              "toStateData": "${.}"
            }
          }
        ],
        "defaultCondition": {
          "transition": "eventTimeout"
        }
      },
      {
        "name": "process-output-validate image-distribute",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "transition": "check disk space-distribute",
        "stateDataFilter": {
          "input": "${. | del(.status) | del(.message) | del(.jobId) | del(.runId)}",
          "output": "${if (.\"app-data\" and (.\"app-data\" | length) > 0) then .\"app-data\" else (. | del(.\"app-data\")) end}"
