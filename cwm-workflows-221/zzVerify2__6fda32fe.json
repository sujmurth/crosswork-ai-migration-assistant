  "definition": {
    "id": "zzVerify2",
    "name": "zzVerify2",
    "start": "exec",
    "states": [
      {
        "end": {
          "terminate": true
        },
        "name": "exec",
        "type": "operation",
        "actions": [
          {
            "name": "runCheck",
            "functionRef": {
              "refName": "REST.Post",
              "arguments": {
                "input": {
                  "data": {
                    "input": {
                      "args": "${ .check.command }"
                    }
                  },
                  "path": "/restconf/operations/devices/device=${ .check.node }/live-status/${ .check.nedExec // \"tailf-ned-cisco-ios-xr-stats\" }:exec/any",
                  "header": {
                    "Accept": "application/yang-data+json",
                    "Content-Type": "application/yang-data+json"
                  }
                },
                "config": {
                  "resourceId": "${ \"nsoRest\" }"
                }
              }
            },
            "actionDataFilter": {
              "results": "${ if .status == 200 then ( .data | to_entries[0].value.result ) else \"\" end }",
              "toStateData": "${ .rawOutput }"
            }
          }
        ],
        "stateDataFilter": {
          "output": "${ { verdict: ( (.rawOutput // \"\") | test(.check.expect) ) } | ( if .verdict then . else error(\"verdict-fail\") end ) }"
        }
      }
    ],
    "version": "1.0",
    "functions": [
      {
        "name": "REST.Post",
        "metadata": {
          "worker": "cwm-solutions-generic.rest"
        },
        "operation": "generic.rest.@latest.request.Post"
      }
    ],
    "specVersion": "0.8"
  },
