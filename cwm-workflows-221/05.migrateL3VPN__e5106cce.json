            },
            {
              "name": "node-4"
            }
          ]
        },
        "name": "getClients",
        "type": "inject",
        "transition": "loopClients"
      },
      {
        "end": true,
        "mode": "sequential",
        "name": "loopClients",
        "type": "foreach",
        "actions": [
          {
            "name": "applyCtSrv6",
            "retryRef": "Default",
            "functionRef": {
              "refName": "NSO.RestconfPatch",
              "arguments": {
                "input": {
                  "data": "${ {\"golden-config:golden-config\": {\"application\": [ {\"device\": .client.name, \"jinja-template\": {\"template\": \"ct-srv6\", \"version\": \"1\"}, \"name\": (\"cwm-gc-ct-srv6-\" + .client.name), \"variable\": [ {\"name\": \"local_as\", \"value\": \"65000\"}, {\"name\": \"vrf_name\", \"value\": \"vpn-101\"}, {\"name\": \"address_family\", \"value\": \"ipv4\"}, {\"name\": \"mpls_alloc\", \"value\": \"enable\"}, {\"name\": \"locator_name\", \"value\": \"MAIN\"}, {\"name\": \"alloc_mode\", \"value\": \"per-vrf\"} ] } ]}} }",
                  "path": "restconf/data/golden-config:golden-config?dry-run=native",
                  "header": {
                    "Accept": "application/yang-data+json",
                    "Content-Type": "application/yang-data+json"
                  }
                },
                "config": {
                  "resourceId": "eNSO"
                }
              }
            }
          }
        ],
        "iterationParam": "client",
        "inputCollection": "${ .clients }"
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT20S",
        "multiplier": 1.5,
        "maxAttempts": 2
      }
