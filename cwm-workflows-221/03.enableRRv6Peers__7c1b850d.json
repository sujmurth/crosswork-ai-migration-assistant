        "code": "HTTP_STATUS_500",
        "name": "noRouteToHost",
        "description": "NSOErr: No Route to NSO host"
      }
    ],
    "states": [
      {
        "data": {
          "clients": [
            {
              "name": "node-2"
            },
            {
              "name": "node-4"
            }
          ]
        },
        "name": "getClients",
        "type": "inject",
        "transition": "loopClients"
      },
      {
        "end": true,
        "mode": "sequential",
        "name": "loopClients",
        "type": "foreach",
        "actions": [
          {
            "name": "applyRRv6Client",
            "retryRef": "Default",
            "functionRef": {
              "refName": "NSO.RestconfPatch",
              "arguments": {
                "input": {
                  "data": "${ {\"golden-config:golden-config\": {\"application\": [ {\"device\": .client.name, \"jinja-template\": {\"template\": \"rr-setup-template\", \"version\": \"1\"}, \"name\": (\"cwm-gc-rrv6-\" + .client.name)} ]}} }",
                  "path": "restconf/data/golden-config:golden-config?dry-run=native",
                  "header": {
                    "Accept": "application/yang-data+json",
                    "Content-Type": "application/yang-data+json"
                  }
                },
                "config": {
                  "resourceId": "eNSO"
                }
              }
            }
          }
        ],
        "iterationParam": "client",
        "inputCollection": "${ .clients }"
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT20S",
        "multiplier": 1.5,
        "maxAttempts": 2
      }
    ],
