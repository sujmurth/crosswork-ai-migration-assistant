{
  "workflowId": "e49ded80-5a1f-42b3-8711-cb97ff4d302c",
  "createdAt": "2026-02-18T01:36:29.028017Z",
  "updatedAt": "2026-06-29T21:45:14.14442Z",
  "name": "cfs-check-cwm-sol",
  "version": "2.1.0",
  "description": "Checks the sanity of the configuration file system. All the values returned as part of the command should be \"OK\". If the validation fails then the status would be returned as \"warning\", else it would be \"success\".",
  "definition": {
    "id": "cfs-check-cwm-sol",
    "name": "cfs-check-cwm-sol",
    "start": "inject-template-and-expressions",
    "errors": [
      {
        "code": "DEFAULT",
        "name": "Default_Exception",
        "description": "DEFAULT ERROR"
      }
    ],
    "states": [
      {
        "data": {
          "template": "Value Line (.+)\nValue Status (\\S+)\n\nStart\n  ^\\s*${Line}\\.\\.\\.${Status} -> Record\n  ^.-> End",
          "expressions": [
            {
              "status": "warning",
              "message": "configuration file system failed the sanity check.",
              "condition": "((. | length == 0) or ([.[] | select(.Status != \"OK\")] | length > 0))"
            }
          ]
        },
        "name": "inject-template-and-expressions",
        "type": "inject",
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Forming inputs for CFS check"
            }
          ]
        },
        "transition": "execute-cfs-check-command"
      },
      {
        "name": "execute-cfs-check-command",
        "type": "operation",
        "actions": [
          {
            "subFlowRef": {
              "invoke": "sync",
              "version": "2.1.0",
              "workflowId": "util-executor-cwm-sol",
              "onParentComplete": "continue"
            },
            "actionDataFilter": {
              "toStateData": "${.rakutilExecutorData}",
              "fromStateData": "${({\"device\": .\"app-data\".device.name, \"NSOResourceId\": .\"app-data\".\"resource\", \"rak-resource\": \"cwm.sol.system.util\", \"command\": \"cfs check\", \"template\": .template, \"expressions\": .expressions, \"vendor\": \"Cisco Systems\"})}"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "Calling util executor"
            }
          ]
        },
        "onErrors": [
          {
            "errorRef": "Default_Exception",
            "transition": "abnormal-exit"
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "validate-rakutil-executor-check"
        }
      },
      {
        "name": "validate-rakutil-executor-check",
        "type": "switch",
        "dataConditions": [
          {
            "name": "success condition",
            "condition": "${ if .rakutilExecutorData.status==\"success\" then true else false end}",
            "transition": "return-success"
          },
          {
            "name": "warning condition",
            "condition": "${ if .rakutilExecutorData.status==\"warning\" then true else false end}",
            "transition": "return-warning"
          },
          {
            "name": "failure condition",
            "condition": "${ if .rakutilExecutorData.status==\"failed\" then true else false end}",
            "transition": "return-failure"
          }
        ],
        "defaultCondition": {
          "transition": "abnormal-exit"
        }
      },
      {
        "name": "return-success",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "CFS check completed successfully"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${ {status:\"success\", message: \"device cfs-check passed\"} }"
        }
      },
      {
        "name": "return-warning",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "CFS check completed with warning"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"warning\", message: \"configuration file system failed the sanity check.\", stash: .rakutilExecutorData.nsoResponse}}"
        }
      },
      {
        "name": "return-failure",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "WARN",
              "message": "CFS check failed"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: (if .rakutilExecutorData.message != null then .rakutilExecutorData.message else \"There was an error in getting proper response for the check.\" end)}}"
        }
      },
      {
        "name": "abnormal-exit",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "metadata": {
          "logs": [
            {
              "level": "INFO",
              "message": "CFS check exited abnormally"
            }
          ]
        },
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "transition": {
          "nextState": "end"
        },
        "stateDataFilter": {
          "output": "${{status:\"failed\", message: (if .rakutilExecutorData.message != null then .rakutilExecutorData.message else \"Exited abnormally\" end)}}"
        }
      },
      {
        "end": true,
        "name": "end",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "timeouts": {
          "stateExecTimeout": "PT15M"
        },
        "stateDataFilter": {
          "output": "${ . }"
        }
      }
    ],
    "version": "2.1.0",
    "metadata": {},
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT15M"
      }
    },
    "functions": [
      {
        "name": "noop",
        "metadata": {
          "worker": "default"
        },
        "operation": "system.function.@latest.common.NoOp"
      }
    ],
    "description": "Checks the sanity of the configuration file system. All the values returned as part of the command should be \"OK\". If the validation fails then the status would be returned as \"warning\", else it would be \"success\".",
    "specVersion": "0.8",
    "dataInputSchema": {
      "schema": {
        "type": "object",
        "title": "CFSCheckSchema",
        "properties": {
          "app-data": {
            "type": "object",
            "required": [
              "device",
              "resource"
            ],
            "properties": {
              "device": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "resource": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "wfTags": [
    "mopActivity",
    "noExport"
  ],
  "formId": "",
  "path": "",
  "hashSum": "098fae450eeae9d5bede999fb64e414dfd8def6e9f9c7c6ab5a33ed9730a5ecb"
}