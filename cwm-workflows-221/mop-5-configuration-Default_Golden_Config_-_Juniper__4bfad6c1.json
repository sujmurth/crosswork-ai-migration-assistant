{
  "workflowId": "4bfad6c1-22ef-4ffb-b656-f1852d87c14f",
  "createdAt": "2026-06-29T21:45:17.122098Z",
  "updatedAt": "2026-06-29T21:45:17.122098Z",
  "name": "mop-5-configuration-Default Golden Config - Juniper",
  "version": "2.1.0",
  "description": "Mop wrapper workflow executes the mop activities of stage configuration.",
  "definition": {
    "id": "mop-5-configuration-Default Golden Config - Juniper",
    "name": "mop-5-configuration-Default Golden Config - Juniper",
    "start": "Apply Config-configuration",
    "events": [
      {
        "name": "cwm.sol.system.mopAction",
        "type": "cwm.sol.system.mopAction",
        "source": "actionStatusSource",
        "correlation": [
          {
            "contextAttributeName": "jobId",
            "contextAttributeValue": "${.jobId}"
          },
          {
            "contextAttributeName": "runId",
            "contextAttributeValue": "${.runId}"
          }
        ]
      }
    ],
    "states": [
      {
        "name": "Apply Config-configuration",
        "type": "operation",
        "actions": [
          {
            "name": "apply-golden-config-cwm-sol-2.1.0",
            "functionRef": {
              "refName": "REST.Post",
              "arguments": {
                "input": {
                  "data": {
                    "jobId": "${$CONST.CWM.JOB_ID}",
                    "mopId": 5,
                    "runId": "${$CONST.CWM.RUN_ID}",
                    "stage": "configuration",
                    "app-data": "${. + {\"actionTimeout\": \"PT35M\"}}"
                  },
                  "path": "v1/mop/action/Apply Config",
                  "header": {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                  }
                },
                "config": {
                  "resource": {
                    "connection": {
                      "host": "cwm-solutions-automation",
                      "port": 8080,
                      "protocol": "http"
                    }
                  }
                }
              }
            },
            "actionDataFilter": {
              "results": "${.data}"
            }
          }
        ],
        "timeouts": {
          "actionExecTimeout": "PT5M"
        },
        "transition": "check-status-Apply Config-configuration",
        "stateDataFilter": {
          "output": "${.}"
        }
      },
      {
        "name": "check-status-Apply Config-configuration",
        "type": "switch",
        "dataConditions": [
          {
            "condition": "${.status == \"success\" or .status == \"warning\"}",
            "transition": "process-output-Apply Config-configuration"
          },
          {
            "condition": "${.status == \"running\"}",
            "transition": "check-event-Apply Config-configuration"
          },
          {
            "condition": "${.status == \"terminated\"}",
            "transition": "abortExecution"
          }
        ],
        "defaultCondition": {
          "transition": "failedExecution"
        }
      },
      {
        "name": "check-event-Apply Config-configuration",
        "type": "switch",
        "timeouts": {
          "eventTimeout": "PT35M"
        },
        "eventConditions": [
          {
            "eventRef": "cwm.sol.system.mopAction",
            "transition": "check-status-Apply Config-configuration",
            "eventDataFilter": {
              "data": "${ {jobId : .jobId, runId : .runId, status : .status, message : .message, \"app-data\": .\"app-data\"} }",
              "toStateData": "${.}"
            }
          }
        ],
        "defaultCondition": {
          "transition": "eventTimeout"
        }
      },
      {
        "name": "process-output-Apply Config-configuration",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "transition": "successExecution",
        "stateDataFilter": {
          "input": "${. | del(.status) | del(.message) | del(.jobId) | del(.runId)}",
          "output": "${if (.\"app-data\" and (.\"app-data\" | length) > 0) then .\"app-data\" else (. | del(.\"app-data\")) end}"
        }
      },
      {
        "end": true,
        "name": "successExecution",
        "type": "operation",
        "actions": [
          {
            "name": "noop",
            "functionRef": {
              "refName": "noop"
            }
          }
        ],
        "stateDataFilter": {
          "output": "${ {\"status\": \"success\", \"message\": \"Workflow execution completed successfully.\", \"app-data\": .} }"
        }
      },
      {
        "end": true,
        "data": {
          "status": "failed",
          "message": "mop action has timed out."
        },
        "name": "eventTimeout",
        "type": "inject"
      },
      {
        "end": true,
        "data": {
          "status": "failed",
          "message": "Workflow execution has been failed."
        },
        "name": "failedExecution",
        "type": "inject"
      },
      {
        "end": true,
        "data": {
          "status": "terminated",
          "message": "Workflow execution has been aborted by the user."
        },
        "name": "abortExecution",
        "type": "inject"
      }
    ],
    "retries": [
      {
        "name": "Default",
        "delay": "PT60S",
        "maxAttempts": 4
      }
    ],
    "version": "2.1.0",
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT26M15S"
      }
    },
    "functions": [
      {
        "name": "REST.Post",
        "metadata": {
          "worker": "cwm-solutions-generic.rest"
        },
        "operation": "generic.rest.@latest.request.Post"
      },
      {
        "name": "noop",
        "metadata": {
          "worker": "default"
        },
        "operation": "system.function.@latest.common.NoOp"
      }
    ],
    "description": "Mop wrapper workflow executes the mop activities of stage configuration.",
    "specVersion": "0.9"
  },
  "wfTags": [
    "system",
    "mop:5",
    "stage:configuration"
  ],
  "formId": "",
  "path": "",
  "hashSum": "6cd9da19531fd731cb8904a2854cf6d1f1fcaf82250aa6d0810de11d11767a6a"
}