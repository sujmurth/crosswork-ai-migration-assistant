                  }
                },
                "config": {
                  "resourceId": "${ \"nsoRest\" }"
                }
              }
            },
            "actionDataFilter": {
              "results": "${ if .status == 200 then ( .data | to_entries[0].value.result ) else \"\" end }",
              "toStateData": "${ .rawOutput }"
            }
          }
        ],
        "stateDataFilter": {
          "output": "${ { name: .check.name, node: .check.node, command: .check.command, expect: .check.expect, phase: .check.phase, output: .rawOutput } | . + { verdict: ( .expect as $exp | if ( (.output // \"\") | test($exp) ) then \"PASS\" else \"FAIL\" end ) } | ( if .verdict == \"PASS\" then . else (\"ASSERT verdict=\" + (.verdict|tostring)) | error end ) }"
        }
      }
    ],
