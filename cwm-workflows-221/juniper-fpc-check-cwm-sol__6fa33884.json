          "comment": "FPC offlined due to unreachable destinations"
        },
        {
          "slot": 4,
          "state": "Empty"
        },
        {
          "slot": 5,
          "state": "Empty"
        },
        {
          "slot": 6,
          "state": "Empty"
        },
        {
          "slot": 7,
          "state": "Empty"
        },
        {
          "slot": 8,
          "state": "Empty"
        },
        {
          "slot": 9,
          "state": "Empty"
        },
        {
          "slot": 10,
          "state": "Offline",
          "comment": "FPC offlined due to unreachable destinations"
        },
        {
          "slot": 11,
          "state": "Empty"
        }
      ]
    },
    "timeouts": {
      "workflowExecTimeout": {
        "duration": "PT15M"
      }
    },
    "functions": [
      {
        "name": "noop",
        "metadata": {
          "worker": "default"
        },
        "operation": "system.function.@latest.common.NoOp"
      }
    ],
    "description": "Checks the status of the device (Juniper devices) to see if the Flexible PIC Concentrator (FPC) details for pre and post upgrade are same. If there are differences then \"warning\" is returned. If the execution fails then the status would be returned as \"failed\", else it would be \"success\".",
    "specVersion": "0.8",
    "dataInputSchema": {
      "schema": {
        "type": "object",
        "title": "fpcCheckSchema",
        "properties": {
          "app-data": {
            "type": "object",
            "required": [
