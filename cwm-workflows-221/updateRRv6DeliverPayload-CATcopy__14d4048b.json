        "operation": "cisco.nso.v1.0.1.device.FetchSshHostKeys"
      },
      {
        "name": "NSO.SetAdminState",
        "operation": "cisco.nso.v1.0.1.device.SetAdminState"
      },
      {
        "name": "NSO.ShowPlatformInfo",
