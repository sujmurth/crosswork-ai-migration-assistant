        "stateDataFilter": {
          "input": "${ . + { phaseLabel: \"phase1-post\", checks: [ { name: \"lo0-ipv6-set\", node: \"node-2\", command: \"show ipv6 interface brief\", expect: \"2010::2\" }, { name: \"ipv6-reach-node4\", node: \"node-2\", command: \"ping 2010::4\", expect: \"!!!!!\" } ] } }"
