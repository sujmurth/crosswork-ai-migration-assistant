{
  "workflowId": "94353bd6-360f-4974-87cb-f83c0e0a12f7",
  "createdAt": "2026-07-17T16:30:07.22603Z",
  "updatedAt": "2026-10-08T07:44:18.257643Z",
  "name": "SRv6-Migration-MOP",
  "version": "1.0",
  "description": "Master MOP for MPLS -> SRv6 migration. Runs the deck/Confluence phases (enable IPv6 -> ISISv6/SRv6 locators -> RRv6 peers -> RRv6 policy LocPref 50 (dual plane) -> per-VRF L3VPN SRv6 -> EVPN-VPWS L2VPN SRv6 (Phase 5b) -> LocPref 150 cutover -> remove MPLS). Every phase does pre-check -> action -> post-check via the reusable 'validateChecks' subflow, a switch gate that HALTS on any failed check, and an operator approval callback (approve-phaseN event) before advancing. Phase 5b migrates the EVPN-VPWS service (vpn-129) via the l2vpn-migrate-template golden config (vpws-seamless-integration + EVI SRv6 locator). Phase 6 auto-rolls-back (LocPref 50) if the cutover post-check fails. Targets remapped for cw-dcloud-v5 (RRv6=pce-11 2011::11, PEs node-2/node-4, L3VPN vpn-101, L2VPN vpn-129). Full editable check set lives in checks-srv6-migration.json.",
  "definition": {
    "id": "SRv6-Migration-MOP-1.0",
    "name": "SRv6-Migration-MOP",
    "start": "Phase 0: Baseline Validation (Pre-Check)",
    "events": [
      {
        "kind": "consumed",
        "name": "webex-approval",
        "type": "cisco.cwm.webex.approval",
        "source": "webex-bot"
      }
    ],
    "states": [
      {
        "name": "Phase 0: Baseline Validation (Pre-Check)",
        "type": "operation",
        "actions": [
          {
            "subFlowRef": {
              "invoke": "sync",
              "version": "1.0",
              "workflowId": "validateChecks"
            },
            "actionDataFilter": {
              "toStateData": "${ .preResult }"
            }
          }
        ],
        "metadata": {
          "phase": "0",
          "title": "Baseline validation (ISISv4 + LDP + RRv4, L3VPN vpn-101, L2VPN vpn-129)"
        },
        "transition": "Phase 0: Baseline Gate",
        "stateDataFilter": {
          "input": "${ . + { phaseLabel: \"phase0-baseline-pre\", checks: [ { name: \"isis-adj-up\", node: \"node-2\", command: \"show isis adjacency\", expect: \"Up\" }, { name: \"ldp-oper\", node: \"node-2\", command: \"show mpls ldp neighbor\", expect: \"Oper\" }, { name: \"rrv4-up\", node: \"node-2\", command: \"show bgp vpnv4 unicast summary\", expect: \"198.19.2.11\" }, { name: \"l3vpn-routes\", node: \"node-2\", command: \"show bgp vpnv4 unicast vrf vpn-101\", expect: \"30.1.1.0/24\" }, { name: \"l2vpn-up\", node: \"node-2\", command: \"show l2vpn xconnect group vpn-129\", expect: \"UP\" } ] } }"
        }
      },
      {
        "name": "Phase 0: Baseline Gate",
        "type": "switch",
        "dataConditions": [
          {
            "condition": "${ true }",
            "transition": "Phase 1: Enable IPv6 Addressing/Routing"
          },
          {
            "condition": "${ .preResult.allPass != true }",
            "transition": "HALT: Check Failed"
          }
        ],
        "defaultCondition": {
          "transition": "HALT: Check Failed"
        }
      },
      {
        "name": "Phase 1: Enable IPv6 Addressing/Routing",
        "type": "operation",
        "actions": [
          {
            "subFlowRef": {
              "invoke": "sync",
              "version": "1.0",
              "workflowId": "01.enableIPV6",
              "onParentComplete": "continue"
            },
            "actionDataFilter": {
              "toStateData": "${ .enableIPv6Result }"
            }
          }
        ],
        "metadata": {
          "phase": "1",
          "title": "[Step 1] Enable IPv6 Addressing/Routing"
        },
        "transition": "Phase 1: Verify IPv6 (Post-Check)"
      },
      {
        "name": "Phase 1: Verify IPv6 (Post-Check)",
        "type": "operation",
        "actions": [
